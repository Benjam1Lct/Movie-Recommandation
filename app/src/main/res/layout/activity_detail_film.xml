<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout pour la vue de détail d’un film.
    Utilise ConstraintLayout comme conteneur principal.
    Le contenu scrollable est placé dans un ScrollView, avec un bouton fixe en bas.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070421"
    tools:context=".DetailFilm">

    <!--
        ScrollView contenant tout le contenu scrollable (image, titre, description...).
        Il s’étend sur toute la hauteur sauf la zone du bouton Retour.
    -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/button_leave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!--
                Affichage de l’image principale (backdrop ou poster) avec un dégradé en bas
                pour lisser la transition avec l’arrière-plan.
            -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/image_film"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:scaleType="centerCrop"
                    tools:srcCompat="@tools:sample/avatars" />

                <!-- Dégradé noir transparent en bas de l’image -->
                <View
                    android:id="@+id/carouselOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_overlay" />
            </FrameLayout>

            <!-- Titre du film -->
            <TextView
                android:id="@+id/titre_film"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:ellipsize="end"
                android:fontFamily="@font/anton"
                android:gravity="center"
                android:maxLines="3"
                android:paddingHorizontal="24dp"
                android:text="Titre"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <!-- Année de sortie + genres -->
            <TextView
                android:id="@+id/date_film"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/ibm_plex_sans"
                android:text="Date"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:paddingHorizontal="20dp"/>

            <!-- Bouton favori + texte "Favori" -->
            <LinearLayout
                android:id="@+id/favButtonBox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <ImageButton
                    android:id="@+id/favButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/ic_star_outline_white" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Favori"
                    android:textColor="@color/white" />


            </LinearLayout>

            <!-- Description complète du film -->
            <TextView
                android:id="@+id/description_film"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/ibm_plex_sans"
                android:padding="12dp"
                android:text="Description très longue du film qui pourrait déborder sur plusieurs lignes. Lorem ipsum dolor sit amet..."
                android:textColor="#DDDDDD"
                android:paddingHorizontal="24dp"
                android:gravity="center"/>
        </LinearLayout>
    </ScrollView>

    <!-- Bouton fixe pour quitter la page (en bas de l’écran) -->
    <Button
        android:id="@+id/button_leave"
        android:layout_width="102dp"
        android:layout_height="48dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="#fff"
        android:scaleType="fitXY"
        android:text="Retour"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
