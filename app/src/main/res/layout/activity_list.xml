<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de l'écran de liste des films.
    Contient :
    - Un Spinner pour trier les résultats
    - Une ListView affichant les films récupérés
    - Deux boutons en bas : "Retour" et "Détails"
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#070421"
    tools:context=".ListFilm">

        <!-- Spinner pour choisir l'ordre de tri (ex: par titre, par date) -->
        <Spinner
            android:id="@+id/spinner_tri"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/rounded_input"
            android:dropDownWidth="wrap_content"
            android:entries="@array/sort_options"
            android:minWidth="120dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Liste des films affichés après la recherche -->
        <ListView
            android:id="@+id/list_film"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:dividerHeight="8dp"
            android:choiceMode="singleChoice"
            app:layout_constraintTop_toBottomOf="@id/spinner_tri"
            app:layout_constraintBottom_toTopOf="@id/layout_buttons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />


        <!-- Zone des boutons en bas : Retour + Détails -->
        <LinearLayout
            android:id="@+id/layout_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

                <!-- Bouton Retour vers l’écran de recherche -->
                <Button
                    android:id="@+id/button_parametre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:text="Retour"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginRight="32dp"/>

                <!-- Bouton pour afficher les détails du film sélectionné -->
                <Button
                    android:id="@+id/button_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:enabled="false"
                    android:text="Détails"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold" />
        </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
