<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de la page d'accueil de l'application.
    Affiche un carrousel en haut avec des images de films récents,
    puis 3 sections thématiques (prochaines sorties, action, horreur),
    chacune avec une image, un titre et un bouton "Voir plus".
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070421">

    <!-- ScrollView principal permettant le défilement vertical -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <!-- Contenu scrollable -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp"> <!-- Espace pour ne pas cacher le contenu derrière la bottom nav -->

            <!-- Frame contenant le carrousel + overlay dégradé -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- RecyclerView horizontal pour les images de films récents -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/carouselRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Overlay en dégradé par-dessus le bas du carrousel -->
                <View
                    android:id="@+id/carouselOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_overlay" />
            </FrameLayout>

            <!-- Sections de catégories (sorties, action, horreur) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/carouselRecycler"
                android:layout_marginTop="20dp"
                android:padding="16dp">

                <!-- ✅ Première catégorie : Prochaines Sorties -->
                <LinearLayout
                    android:id="@+id/cat1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginBottom="20dp">

                    <!-- Image de l'affiche -->
                    <ImageView
                        android:id="@+id/cat1_imageView"
                        android:layout_width="80dp"
                        android:layout_height="120dp"
                        android:scaleType="fitCenter"
                        tools:srcCompat="@tools:sample/avatars" />

                    <!-- Texte + bouton -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingLeft="20dp"
                        android:translationY="-10dp">

                        <TextView
                            android:id="@+id/cat1_textView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_marginBottom="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/anton"
                            android:text="Prochaines Sorties"
                            android:textColor="#FDFDFD"
                            android:textSize="28sp"
                            android:translationY="-5dp" />

                        <Button
                            android:id="@+id/cat1_more"
                            android:layout_width="110dp"
                            android:layout_height="50dp"
                            android:backgroundTint="#e30e31"
                            android:text="Voir plus"
                            android:textColor="#fff"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Séparateur visuel -->
                <View
                    android:id="@+id/divider24"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/rounded_background_bright_borderless" />

                <!-- ✅ Deuxième catégorie : Films Action -->
                <LinearLayout
                    android:id="@+id/cat2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="top"
                    android:layout_marginVertical="20dp">

                    <ImageView
                        android:id="@+id/cat2_imageView"
                        android:layout_width="80dp"
                        android:layout_height="120dp"
                        android:scaleType="fitCenter"
                        tools:srcCompat="@tools:sample/avatars" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingLeft="20dp"
                        android:translationY="-10dp">

                        <TextView
                            android:id="@+id/cat2_textView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_marginBottom="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/anton"
                            android:text="Films Action"
                            android:textColor="#FDFDFD"
                            android:textSize="28sp" />

                        <Button
                            android:id="@+id/cat2_more"
                            android:layout_width="110dp"
                            android:layout_height="50dp"
                            android:backgroundTint="#e30e31"
                            android:text="Voir plus"
                            android:textColor="#fff"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Séparateur -->
                <View
                    android:id="@+id/divider2"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@drawable/rounded_background_bright_borderless" />

                <!-- ✅ Troisième catégorie : Films Horreur -->
                <LinearLayout
                android:id="@+id/cat3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="top"
                    android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/cat3_imageView"
                    android:layout_width="80dp"
                    android:layout_height="120dp"
                    android:scaleType="fitCenter"
                    tools:srcCompat="@tools:sample/avatars" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingLeft="20dp"
                        android:translationY="-10dp">

                        <TextView
                            android:id="@+id/cat3_textView"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:layout_marginBottom="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/anton"
                            android:text="Films Horreur"
                            android:textColor="#FDFDFD"
                            android:textSize="28sp" />

                        <Button
                            android:id="@+id/cat3_more"
                            android:layout_width="110dp"
                            android:layout_height="50dp"
                            android:backgroundTint="#e30e31"
                            android:text="Voir plus"
                            android:textColor="#fff"
                            android:textStyle="bold" />
                    </LinearLayout>
            </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>
    <!-- Carrousel d'images -->






</androidx.constraintlayout.widget.ConstraintLayout>
